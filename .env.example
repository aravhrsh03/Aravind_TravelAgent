# Copy to .env and fill in. Never commit .env.
# Without a key WanderVision runs fully offline with deterministic agents.
ANTHROPIC_API_KEY=
# auto | anthropic | offline
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5-5
# Set to false to skip the cross-encoder reranker (faster, slightly lower precision)
USE_RERANKER=true
WANDERVISION_API=http://127.0.0.1:8000
